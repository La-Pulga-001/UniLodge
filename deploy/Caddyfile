# Caddy reverse proxy for the production Compose stack.
#
# SITE_ADDRESS is set in .env:
#   - a domain, e.g. unilodge.example.com  -> automatic HTTPS
#   - an sslip.io name, e.g. unilodge.203.0.113.10.sslip.io -> automatic HTTPS
#   - ":80" for a plain HTTP IP-only demo
#
# ACME_EMAIL is optional but recommended so Let's Encrypt can contact you.

{
	email {$ACME_EMAIL:no-reply@unilodge.local}
}

{$SITE_ADDRESS} {
	encode zstd gzip
	reverse_proxy app:8080
}
