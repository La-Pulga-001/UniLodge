# Copy this file to .env and fill in real values before running Docker Compose.
# Never commit .env to version control.

# Database
POSTGRES_DB=unilodge
POSTGRES_USER=unilodge_app
DB_PASSWORD=change-me-strong-database-password

# Security: at least 32 random characters
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Public address used in emails and invitation links
APP_URL=http://localhost:8080

# SMTP delivery (required in production; development logs codes to the console)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=change-me
MAIL_FROM=UniLodge <no-reply@example.com>

# Optional: comma-separated list of extra allowed browser origins
CORS_ORIGINS=
