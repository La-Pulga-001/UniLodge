# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# --- Database ---------------------------------------------------------------
POSTGRES_DB=unilodge
POSTGRES_USER=unilodge_app
DB_PASSWORD=change-me-strong-database-password

# --- Security ---------------------------------------------------------------
# At least 32 random characters, e.g. `openssl rand -base64 48`.
# Never change it after users have signed in.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# --- Public address ---------------------------------------------------------
# APP_URL is used in email links and must be the final https:// address.
# On Render, leave it unset: the prod profile uses RENDER_EXTERNAL_URL
# automatically. Set it only when attaching a custom domain.
APP_URL=http://localhost:8080

# --- Demo content -----------------------------------------------------------
# true seeds 18 listings (12 featured), board posts and demo accounts.
DEMO_DATA=true

# --- Email ------------------------------------------------------------------
# "console" writes emails, including OTP codes, to the container log.
MAIL_MODE=console
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=change-me
MAIL_FROM=UniLodge <no-reply@example.com>

# Optional: comma-separated list of extra allowed browser origins
CORS_ORIGINS=
